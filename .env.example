# Copiez ce fichier en .env pour un usage local.
# Ce fichier n'est lu que par le serveur : aucune valeur n'est envoyée au navigateur.

# Clé Upload-Post (même clé que pour le serveur MCP), pour publier depuis l'outil en local.
# Ne la renseignez PAS sur Vercel : la démo en ligne ne publie rien.
UPLOAD_POST_API_KEY=votre-cle

# Mode démo : à mettre à true uniquement sur Vercel (Settings → Environment Variables).
# En local, laissez-le absent pour garder la génération par l'IA.
# DEMO_MODE=true
